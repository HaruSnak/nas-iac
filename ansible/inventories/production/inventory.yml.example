all:
  children:
    nas:
      vars:
        ansible_python_interpreter: /usr/bin/python3
      children:
        nas_admin:
          hosts:
            dxp2800-admin:
              ansible_host: XXX.XXX.XXX.XXX
              ansible_user: XXXXXXXXXXXXX
              ansible_ssh_private_key_file: ~/.ssh/nas-iac-admin
              ansible_become_password: "{{ vault_nas_admin_become_password }}"
        nas_service:
          hosts:
            dxp2800-service:
              ansible_host: XXX.XXX.XXX.XXX
              ansible_user: XXXXXXXXX
              ansible_ssh_private_key_file: ~/.ssh/nas-iac-service
              ansible_become_password: "{{ vault_nas_service_become_password }}"
